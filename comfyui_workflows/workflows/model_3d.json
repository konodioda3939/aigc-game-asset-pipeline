{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "example.png"},
    "_meta": {"title": "Load Reference Image"}
  },
  "2": {
    "class_type": "TripoSRModelLoader",
    "inputs": {
      "model": "TripoSR_model.ckpt",
      "chunk_size": 8192
    },
    "_meta": {"title": "Load TripoSR Model"}
  },
  "3": {
    "class_type": "TripoSRSampler",
    "inputs": {
      "model": ["2", 0],
      "reference_image": ["1", 0],
      "geometry_resolution": 256,
      "threshold": 25.0
    },
    "_meta": {"title": "TripoSR Sampler"}
  },
  "4": {
    "class_type": "TripoSRMeshSave",
    "inputs": {
      "mesh": ["3", 0],
      "output_format": "glb",
      "cleanup_mesh": true,
      "keep_largest_only": true
    },
    "_meta": {"title": "Save Mesh + Cleanup"}
  },
  "5": {
    "class_type": "Preview3D",
    "inputs": {
      "model_file": ["4", 0]
    },
    "_meta": {"title": "3D Preview (rotate/zoom in browser)"}
  }
}
